# ──────────────────────────────────────────────────────────────────────────
#  APP
# ──────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGINS=*
# Public URL of the frontend — Paystack sends buyers back here after checkout.
APP_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────
#  AUTH
# ──────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────────────────────────────────────────
#  DATABASE
#  Default: sqlite file (local dev). For production, create a Supabase (or
#  any Postgres) project and set DB_TYPE=postgres with the DB_* vars below.
# ──────────────────────────────────────────────────────────────────────────
# DB_TYPE=sqlite
# DB_DATABASE=./data/admitly.sqlite
DB_TYPE=sqlite
DB_DATABASE=./data/admitly.sqlite
# DB_TYPE=postgres
# DB_HOST=
# DB_PORT=5432
# DB_USERNAME=
# DB_PASSWORD=
# DB_DATABASE=postgres

# ──────────────────────────────────────────────────────────────────────────
#  SUPABASE STORAGE  (invitee avatar photos uploaded by admins)
#  Create a Supabase project, then a private storage bucket (default name
#  below), and paste the project URL + service_role key here.
# ──────────────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=invitee-avatars

# ──────────────────────────────────────────────────────────────────────────
#  BILLING (Paystack)  — optional
#  Free accounts can create 50 invites in total, across all their events.
#  Paid accounts get 500. Both defaults are editable at runtime by a platform
#  admin via PATCH /platform/settings.
#  Leave the keys empty to run without billing: the app boots normally and the
#  upgrade endpoints return 503 until they are filled in.
#  PAYSTACK_UPGRADE_AMOUNT_MINOR is in the currency's minor unit (kobo = ₦ × 100).
# ──────────────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=NGN
PAYSTACK_UPGRADE_AMOUNT_MINOR=500000
# Defaults to ${APP_URL}/admin/billing/callback when left empty.
PAYSTACK_CALLBACK_URL=

# ──────────────────────────────────────────────────────────────────────────
#  PLATFORM ADMIN SEED  — used only by `npm run seed:platform-admin`
#  The account is promoted if it already exists; otherwise it is created
#  inside PLATFORM_ADMIN_ORG_NAME (which is created on demand).
# ──────────────────────────────────────────────────────────────────────────
PLATFORM_ADMIN_EMAIL=caesaradek@gmail.com
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Owner
PLATFORM_ADMIN_ORG_NAME=Admitly Platform

# ──────────────────────────────────────────────────────────────────────────
#  RATE LIMITING
# ──────────────────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=120
